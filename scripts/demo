#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
allowlist=${SZPONT_DEMO_ALLOWLIST:-"$repo_root/.tmp/demo-sessions.json"}
binary="$repo_root/szpont/target/debug/szpont"

case "${1-}" in
  --prepare)
    if [ "$#" -ne 1 ]; then
      echo "usage: $0 [--prepare]" >&2
      exit 2
    fi
    cargo build --quiet --manifest-path "$repo_root/szpont/Cargo.toml"
    echo "demo binary prepared: $binary"
    exit 0
    ;;
  "") ;;
  *)
    echo "usage: $0 [--prepare]" >&2
    exit 2
    ;;
esac

if [ ! -f "$allowlist" ]; then
  echo "demo allowlist not found: $allowlist" >&2
  exit 1
fi

if [ ! -x "$binary" ]; then
  echo "demo binary is not prepared; run: $0 --prepare" >&2
  exit 1
fi

mkdir -p "$repo_root/.tmp"
runtime=$(mktemp -d "$repo_root/.tmp/szpont-demo.XXXXXX")

cleanup() {
  case "$runtime" in
    "$repo_root"/.tmp/szpont-demo.*) rm -rf -- "$runtime" ;;
    *) echo "refusing to remove unexpected demo runtime: $runtime" >&2 ;;
  esac
}
trap cleanup EXIT HUP INT TERM

"$binary" \
  --global \
  --session-allowlist "$allowlist" \
  --db "$runtime/szpont.db"
